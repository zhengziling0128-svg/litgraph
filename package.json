{
  "name": "dsh-litgraph",
  "version": "0.1.0",
  "description": "LitGraph · literature knowledge-graph plugin for DeepSeek Harness: star-map knowledge graph, PDF/Zotero import, OCR, notes, ratings, journal metrics",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "0.22.14",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsdown",
    "smoke": "node scripts/smoke.mjs",
    "install:desktop": "node scripts/install-desktop.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "sql.js": "^1.17.0",
    "unpdf": "^2.2.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "literature",
    "knowledge-graph",
    "zotero",
    "pdf",
    "ocr"
  ],
  "author": "LitGraph contributors"
}
